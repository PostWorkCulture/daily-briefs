    "category": "Extreme life",
    "country": "Antarctica",
    "place": "Blood Falls · Taylor Glacier",
    "source": "U.S. National Science Foundation",
    "sourceUrl": "https://par.nsf.gov/biblio/10347293-multi-technique-analysis-surface-materials-from-blood-falls-antarctica",
